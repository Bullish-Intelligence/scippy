{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scippy.invalid/schema/metalayer-v1.schema.json",
  "title": "Scippy metalayer envelope, format version 1",
  "description": "The output of `scippy metalayer <command> --json`. Readers must ignore unknown fields and unknown enum values. Known enum values are in `examples`, so a new value still validates.",
  "type": "object",
  "required": ["format_version", "tool", "command", "ok"],
  "properties": {
    "format_version": {"type": "integer", "const": 1},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "examples": ["scippy"]},
        "version": {"type": "string"}
      }
    },
    "command": {
      "type": "string",
      "examples": [
        "index", "show", "files", "relations", "edges", "explain", "check", "entity",
        "annotate add", "annotate list", "annotate rm", "annotate status", "annotate accept",
        "annotate reject"
      ]
    },
    "ok": {"type": "boolean"}
  },
  "if": {"required": ["ok"], "properties": {"ok": {"const": false}}},
  "then": {"$ref": "#/$defs/error_envelope"},
  "else": {"$ref": "#/$defs/success_envelope"},
  "$defs": {
    "error_envelope": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["kind", "message"],
          "properties": {
            "kind": {
              "type": "string",
              "examples": [
                "no-revision",
                "database-missing",
                "schema-mismatch",
                "not-found",
                "bad-argument",
                "storage",
                "io",
                "no-identity-store",
                "no-entity",
                "ambiguous-locator",
                "candidate-annotated",
                "identity-schema-mismatch",
                "incomplete",
                "root-set-mismatch"
              ]
            },
            "message": {"type": "string"}
          }
        }
      }
    },
    "success_envelope": {
      "description": "There are two success envelope types. An envelope with an `identity` block comes from a command of the identity store (`entity`, `annotate`). It has no revision. Any other envelope is a facts envelope. The facts envelope of `index` has the flags and no revision fields.",
      "if": {"required": ["identity"]},
      "then": {"$ref": "#/$defs/identity_envelope"},
      "else": {"$ref": "#/$defs/facts_envelope"}
    },
    "identity_envelope": {
      "type": "object",
      "required": ["identity", "value"],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["path", "version", "bound_input_digest"],
          "properties": {
            "path": {"type": "string", "description": "The identity store file."},
            "version": {"type": "integer", "description": "The format version of the identity store."},
            "bound_input_digest": {
              "type": ["string", "null"],
              "description": "The facts input_digest of the last rebinding. Null before the first rebinding. Compare it with revision.input_digest of a facts command."
            }
          }
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "entity"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/entity.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate add"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-add.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate list"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-list.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate rm"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-rm.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate status"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-status.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate accept"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-accept.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "annotate reject"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/annotate-reject.value.json"}}}
        }
      ]
    },
    "facts_envelope": {
      "type": "object",
      "description": "The flags and the value are always present. Every command except `index` also reads a stored revision, so it carries the revision fields. `index` carries the revision of its publication in `value.metalayer`.",
      "required": ["input_complete", "analysis_exact", "value"],
      "properties": {
        "revision": {
          "type": "object",
          "required": ["id", "input_digest", "created_at", "tool_version", "scip_sha256", "scip_size"],
          "properties": {
            "id": {"type": "integer"},
            "input_digest": {"type": "string"},
            "created_at": {"type": "string"},
            "tool_version": {"type": "string"},
            "scip_sha256": {"type": "string"},
            "scip_size": {"type": "integer", "minimum": 0}
          }
        },
        "root_set": {
          "type": "object",
          "required": ["key", "project_root", "shards"],
          "properties": {
            "key": {"type": "string"},
            "project_root": {"type": "string"},
            "shards": {"type": "array", "items": {"type": "string"}}
          }
        },
        "input_complete": {"type": "boolean"},
        "analysis_exact": {"type": "boolean"},
        "position_encoding": {"type": "string", "examples": ["utf8-byte"]},
        "schema_version": {"type": "integer"},
        "value": {}
      },
      "allOf": [
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "index"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/index.value.json"}}},
          "else": {"required": ["revision", "root_set", "position_encoding", "schema_version"]}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "show"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/show.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "files"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/files.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "relations"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/relations.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "edges"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/edges.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "explain"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/explain.value.json"}}}
        },
        {
          "if": {"required": ["command"], "properties": {"command": {"const": "check"}}},
          "then": {"properties": {"value": {"$ref": "metalayer-v1/check.value.json"}}}
        }
      ]
    },
    "list": {
      "description": "The value of a list command. A value file adds the item schema.",
      "type": "object",
      "required": ["items", "total", "truncated"],
      "properties": {
        "items": {"type": "array"},
        "total": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"}
      }
    },
    "symbol": {
      "description": "A symbol. The file is set for a local symbol only.",
      "type": "object",
      "required": ["symbol"],
      "properties": {
        "symbol": {"type": "string"},
        "file": {"type": ["string", "null"]}
      }
    },
    "entity_locator": {
      "description": "One locator of an entity. Seq 0 is the current locator. The container lists display names, outer to inner.",
      "type": "object",
      "required": ["seq", "key", "path", "kind", "name", "container", "input_digest"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0},
        "key": {"type": "string"},
        "symbol": {"type": ["string", "null"]},
        "path": {"type": "string"},
        "kind": {"type": "string"},
        "name": {"type": "string"},
        "container": {"type": "array", "items": {"type": "string"}},
        "sig_digest": {"type": ["string", "null"]},
        "body_digest": {"type": ["string", "null"]},
        "body_tokens": {"type": ["integer", "null"]},
        "input_digest": {"type": "string"}
      }
    },
    "annotation": {
      "description": "One user annotation. The snapshot is the locator at creation.",
      "type": "object",
      "required": ["id", "entity_id", "created_at", "author", "tag", "body", "snapshot"],
      "properties": {
        "id": {"type": "string"},
        "entity_id": {"type": "string"},
        "created_at": {"type": "string"},
        "author": {"type": ["string", "null"]},
        "tag": {"type": ["string", "null"]},
        "body": {"type": "string"},
        "snapshot": {}
      }
    },
    "entity_summary": {
      "description": "An entity in a short form.",
      "type": "object",
      "required": ["id", "family", "kind", "state", "tier", "locator"],
      "properties": {
        "id": {"type": "string"},
        "family": {"type": "string", "examples": ["code", "note"]},
        "kind": {
          "type": "string",
          "examples": ["module", "class", "function", "method", "variable", "parameter", "note", "heading", "block"]
        },
        "state": {"type": "string", "examples": ["matched", "moved", "ambiguous", "orphaned"]},
        "tier": {
          "type": ["string", "null"],
          "examples": ["T1h", "T2f", "T2", "T3", "T4", "T5", "M2", "M3", "M4", "M5", "Param"]
        },
        "locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/entity_locator"}]}
      }
    },
    "span": {
      "description": "A byte range [start, end] of UTF-8 bytes in the file.",
      "type": ["array", "null"],
      "items": {"type": "integer", "minimum": 0},
      "minItems": 2,
      "maxItems": 2
    }
  }
}
